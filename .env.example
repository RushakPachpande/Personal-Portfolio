# Environment template - copy, then replace every `change-this` value.
#
#   cp .env.example .env.dev    # development (npm run dev, npm run db:seed)
#   cp .env.example .env.prod   # production (npm run build, npm run preview, npm run db:seed:prod)
#
#   .env.local - optional machine-only overrides (wins over .env.dev)
#
# Tags used below:
#   [REQUIRED]  - needed in both dev and prod
#   [DEV ONLY]  - only used in development
#   [PROD ONLY] - only used in production / CI builds
#
# CI (GitHub Pages deploy) reads no env file. Set the [REQUIRED] VITE_* vars as
# Environment secrets under Settings > Environments > github-pages.
# SUPABASE_SERVICE_ROLE_KEY stays local - never set it in CI.

# ---------------------------------------------------------------------------
# [REQUIRED] Browser (Vite) - exposed to the client bundle
# ---------------------------------------------------------------------------
# dev: http://127.0.0.1:54321 | prod: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=change-this-supabase-url
VITE_SUPABASE_ANON_KEY=change-this-anon-key
VITE_ADMIN_BASE_PATH=/_sys/change-this

# ---------------------------------------------------------------------------
# [REQUIRED] Seed scripts only - server-side secret, never prefix with VITE_
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=change-this-service-role-key

# ---------------------------------------------------------------------------
# [PROD ONLY] Build-time Vite base path (the deploy workflow sets this itself)
# ---------------------------------------------------------------------------
# PAGES_BASE_PATH=/

# ---------------------------------------------------------------------------
# [REQUIRED] Admin user created by the seed (dev and prod) when both are set.
# Omit both to skip admin creation and make the user in Supabase Studio instead.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=change-this@example.com
ADMIN_PASSWORD=change-this-strong-password
