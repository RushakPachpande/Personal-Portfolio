# Environment files (do not commit real values)
#
# Development (`npm run dev`, `npm run db:seed`)
#   .env.dev     — copy this template
#   .env.local   — optional machine-only overrides (wins over .env.dev)
#
# Production (`npm run build`, `npm run preview`, `npm run db:seed:prod`)
#   .env.prod    — copy this template and fill cloud values
#
# cp .env.example .env.dev
# cp .env.example .env.prod

# Browser (Vite)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-status
VITE_ADMIN_BASE_PATH=/_sys/r7k9

# Seed script only — never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-supabase-status

# Optional: created on seed if both are set
ADMIN_EMAIL=administrator@portfolio.local
ADMIN_PASSWORD=replace-with-a-strong-password
