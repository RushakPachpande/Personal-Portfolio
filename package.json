{
  "name": "rushak-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build": "tsc -b && vite build --mode prod",
    "build:analyze": "tsc -b && vite build --mode prod",
    "postbuild": "node scripts/copy-spa-fallback.mjs",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --mode prod",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push",
    "db:seed": "tsx --tsconfig tsconfig.app.json --import ./scripts/register-assets.mjs scripts/seed-portfolio.ts --env=dev",
    "db:seed:prod": "tsx --tsconfig tsconfig.app.json --import ./scripts/register-assets.mjs scripts/seed-portfolio.ts --env=prod",
    "db:dedupe-media": "tsx --tsconfig tsconfig.app.json scripts/dedupe-portfolio-media.ts --env=dev",
    "db:dedupe-media:prod": "tsx --tsconfig tsconfig.app.json scripts/dedupe-portfolio-media.ts --env=prod"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoskills": "^0.3.6",
    "dotenv": "^17.4.2",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
